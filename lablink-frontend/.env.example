# LabLink Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored by default in Vite projects.

# Backend API base URL.
# In development, leave empty — Vite proxies /api → http://localhost:8080
# In production (Vercel), set this to your deployed backend URL.
VITE_API_URL=https://api.lablink.edu/api/v1
