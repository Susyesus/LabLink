<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme — Dark -->
    <style name="Theme.LabLink" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.LabLink.Splash" parent="Theme.LabLink">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.LabLink.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <!-- Outlined Button -->
    <style name="Widget.LabLink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Text Button -->
    <style name="Widget.LabLink.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- TextInputLayout -->
    <style name="Widget.LabLink.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="hintTextColor">@color/muted</item>
        <item name="boxBackgroundColor">@color/bg</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <!-- Base Text Appearance -->
    <style name="TextAppearance.LabLink" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.LabLink.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <style name="TextAppearance.LabLink.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <style name="TextAppearance.LabLink.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.LabLink.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
