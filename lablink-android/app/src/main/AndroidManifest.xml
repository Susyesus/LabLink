<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LabLinkApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LabLink"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".feature.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.LabLink.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".feature.auth.ui.LoginActivity"
            android:exported="false" />
        <activity android:name=".feature.auth.ui.RegisterActivity"
            android:exported="false" />
        <activity android:name=".feature.equipment.ui.DashboardActivity"
            android:exported="false" />
        <activity android:name=".feature.profile.ui.ProfileActivity"
            android:exported="false" />
        <activity android:name=".feature.profile.ui.EditProfileActivity"
            android:exported="false" />
        <activity android:name=".feature.profile.ui.ChangePasswordActivity"
            android:exported="false" />

    </application>

</manifest>
