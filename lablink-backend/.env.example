# LabLink Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Load with: export $(cat .env | xargs) before running, or configure
# in your IDE's Run Configuration / Railway / Render environment settings.
# ⚠️  Never commit .env to source control.

# ── Supabase Database (Transaction Pooler) ────────────────────
# Found in: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the "Transaction" pooler mode (port 6543), NOT the direct connection (port 5432),
# because direct connections are limited on the free tier.
SUPABASE_DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_USER=postgres.njmfdbirpdnzhgohxhbe
SUPABASE_DB_PASSWORD=REPLACE_WITH_YOUR_PASSWORD_AFTER_ROTATING

# ── JWT ───────────────────────────────────────────────────────
# Generate a fresh secret with: openssl rand -base64 32
JWT_SECRET=REPLACE_ME_WITH_A_REAL_256_BIT_BASE64_SECRET

# ── Spring Profile ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── CORS ─────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
